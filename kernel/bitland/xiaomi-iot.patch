 static int bitland_mifs_wmi_resume(struct device *dev)
 {
 	struct bitland_mifs_wmi_data *data = dev_get_drvdata(dev);
-
-	/* Skip event device */
-	if (!data->pp_dev)
+	int ret;
+
+	/* Skip event devices and profiles that could not be saved. */
+	if (!data->pp_dev || !data->saved_profile_valid)
 		return 0;
 
+	data->saved_profile_valid = false;
 	dev_dbg(dev, "Resuming, restoring profile %d\n", data->saved_profile);
-	return laptop_profile_set(dev, data->saved_profile);
+	if (data->tm2425_profiles)
+		ret = xiaomi_profile_write(data, data->saved_mode);
+	else
+		ret = laptop_profile_set(data->pp_dev, data->saved_profile);
+	if (ret)
+		dev_warn(dev, "Failed to restore platform profile: %d; continuing resume\n", ret);
+
+	return 0;
 }
 
